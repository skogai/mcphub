{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--headless"
      ],
      "enabled": false,
      "visibility": "private",
      "enableKeepAlive": false
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true,
      "owner": "admin",
      "visibility": "public",
      "enableKeepAlive": false
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "enabled": true,
      "owner": "admin",
      "visibility": "private",
      "enableKeepAlive": false
    },
    "gotohuman-mcp-server": {
      "type": "stdio",
      "command": "node",
      "args": [
        "build/index.js"
      ],
      "enabled": false,
      "owner": "admin",
      "visibility": "private",
      "enableKeepAlive": false,
      "options": {
        "resetTimeoutOnProgress": true
      }
    },
    "any-chat-completions": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "https://github.com/pyroprompts/any-chat-completions-mcp"
      ],
      "env": {
        "AI_CHAT_KEY": "${AI_CHAT_KEY}",
        "AI_CHAT_NAME": "${AI_CHAT_NAME}",
        "AI_CHAT_MODEL": "${AI_CHAT_MODEL}",
        "AI_CHAT_BASE_URL": "${AI_CHAT_BASE_URL}"
